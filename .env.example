# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-alpha/0.1 by yourusername

# Optional: NewsAPI (https://newsapi.org/)
NEWS_API_KEY=

# Optional: X / Twitter (paid API)
TWITTER_BEARER_TOKEN=

# Optional: OpenAI for LLM sentiment (local scorer works without this)
OPENAI_API_KEY=

# Schwab Trader API (https://developer.schwab.com/)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=schwab_token.json

# Safety — keep false until you explicitly unlock live trading
LIVE_TRADING=false
